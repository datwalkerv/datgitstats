# Optional. Server-side only, never exposed to the browser.
# With a token the app uses GitHub GraphQL: exact language byte counts, higher rate limits.
# Several tokens can be comma-separated; exhausted ones are rotated out automatically.
# A fine-grained or classic token with no scopes is enough for public data.
GITHUB_TOKEN=

# Optional. Public origin used in generated README snippets (defaults to the current origin / Vercel URL).
NEXT_PUBLIC_SITE_URL=

# Optional. Shows a GitHub link in the header.
NEXT_PUBLIC_REPO_URL=
